rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.email == 'revanrajkata2628@gmail.com'
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.token.email == 'revanrajkata2628@gmail.com';
    }
  }
}
